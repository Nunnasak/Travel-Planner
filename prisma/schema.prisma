generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  NATURE        @map("nature")
  CULTURE       @map("culture")
  ADVENTURE     @map("adventure")
  MARINE        @map("marine")
  WELLNESS      @map("wellness")
  CULINARY      @map("culinary")
  RELIGIOUS     @map("religious")
  AGRITOURISM   @map("agritourism")
  COMMUNITY     @map("community")
  SPORTS        @map("sports")
  ENTERTAINMENT @map("entertainment")

  @@map("category")
}

enum Role {
  EDITOR
  VIEWER

  @@map("role")
}

model User {
  user_id       Int      @id @default(autoincrement())
  username      String
  email         String   @unique
  created_at    DateTime @default(now())
  password_hash String

  memberships    ScheduleMember[]
  ownedSchedules Schedule[]        @relation("ScheduleOwner")

  @@map("users")
}

model Schedule {
  schedule_id   Int      @id @default(autoincrement())
  schedule_name String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  description   String?
  total_day     Int
  cover_url     String?
  category      Category
  owner_id      Int

  owner   User           @relation("ScheduleOwner", fields: [owner_id], references: [user_id], onDelete: Cascade)
  items   ScheduleItem[]
  members ScheduleMember[]

  @@index([owner_id])
  @@map("schedules")
}

model ScheduleItem {
  item_id     Int      @id @default(autoincrement())
  sequence_no Int
  visit_time  DateTime @db.Time(0)
  day_no      Int
  schedule_id Int
  location_id Int

  schedule Schedule @relation(fields: [schedule_id], references: [schedule_id], onDelete: Cascade)
  location Location @relation(fields: [location_id], references: [location_id])

  @@index([location_id])
  @@unique([schedule_id, day_no, sequence_no])
  @@map("schedule_items")
}

model Location {
  location_id Int    @id @default(autoincrement())
  name        String
  address     String
  city_id     Int
  image_url   String?

  city  City          @relation(fields: [city_id], references: [city_id])
  items ScheduleItem[]

  @@index([city_id])
  @@map("locations")
}

model City {
  city_id     Int    @id @default(autoincrement())
  city_name   String
  province_id Int

  province  Province   @relation(fields: [province_id], references: [province_id])
  locations Location[]

  @@index([province_id])
  @@map("cities")
}

model Province {
  province_id   Int    @id @default(autoincrement())
  province_name String

  cities City[]
  @@map("provinces")
}

model ScheduleMember {
  user_id     Int
  schedule_id Int
  role        Role @default(VIEWER)

  user     User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  schedule Schedule @relation(fields: [schedule_id], references: [schedule_id], onDelete: Cascade)

  @@id([user_id, schedule_id])
  @@index([schedule_id])
  @@map("schedule_members")
}