# Host port for the Docker PostgreSQL. Change it (and the ports in the URLs below) if 5432 is already in use.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://travel_user:travel_password@localhost:5432/travel_planner?schema=public"
TEST_DATABASE_URL="postgresql://travel_user:travel_password@localhost:5432/travel_planner_test?schema=public"
UPLOAD_DIR="uploads"
